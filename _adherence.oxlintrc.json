{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/terminal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmountField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|currency|readOnly|key|ref|className|style|children)$/]",
        "message": "<AmountField> doesn't accept that prop. Declared props: label, value, onChange, currency, readOnly."
      },
      {
        "selector": "JSXOpeningElement[name.name='AssetCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|name|pair|price|delta|series|onMenu|key|ref|className|style|children)$/]",
        "message": "<AssetCard> doesn't accept that prop. Declared props: symbol, name, pair, price, delta, series, onMenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|neutral|positive|negative|warn)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'neutral' | 'positive' | 'negative' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailingIcon|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailingIcon, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Candle'] > JSXAttribute > JSXIdentifier[name!=/^(?:o|h|l|c|key|ref|className|style|children)$/]",
        "message": "<Candle> doesn't accept that prop. Declared props: o, h, l, c."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|interactive|glow|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, interactive, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|panel|inset)$/]",
        "message": "<Card> variant must be one of 'card' | 'panel' | 'inset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:up|down|accent)$/]",
        "message": "<Card> glow must be one of 'up' | 'down' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoinMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|size|ring|key|ref|className|style|children)$/]",
        "message": "<CoinMark> doesn't accept that prop. Declared props: symbol, size, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeltaChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|showIcon|size|key|ref|className|style|children)$/]",
        "message": "<DeltaChip> doesn't accept that prop. Declared props: value, showIcon, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeltaChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<DeltaChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<FilterTabs> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|label|dot|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, label, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inset|bare)$/]",
        "message": "<IconButton> variant must be one of 'inset' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarketRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|name|price|deltas|marketCap|volume|series|key|ref|className|style|children)$/]",
        "message": "<MarketRow> doesn't accept that prop. Declared props: symbol, name, price, deltas, marketCap, volume, series."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|suffix|size|key|ref|className|style|children)$/]",
        "message": "<PriceValue> doesn't accept that prop. Declared props: value, currency, suffix, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceValue'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PriceValue> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|countdown|key|ref|className|style|children)$/]",
        "message": "<PromoBanner> doesn't accept that prop. Declared props: children, countdown."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|showValue|key|ref|className|style|children)$/]",
        "message": "<RangeSlider> doesn't accept that prop. Declared props: value, onChange, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:shortcut|width|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: shortcut, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|eyebrowIcon|title|live|actions|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, eyebrowIcon, title, live, actions, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<SectionHeader> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|fullWidth|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|leading|width|key|ref|className|style|children)$/]",
        "message": "<SelectMenu> doesn't accept that prop. Declared props: options, value, onChange, leading, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|badge|dot|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon, badge, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:points|width|height|tone|markers|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: points, width, height, tone, markers."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|up|down)$/]",
        "message": "<Sparkline> tone must be one of 'accent' | 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:symbol|price|quote|key|ref|className|style|children)$/]",
        "message": "<TickerItem> doesn't accept that prop. Declared props: symbol, price, quote."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:crumbs|wallet|address|onSearch|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: crumbs, wallet, address, onSearch."
      }
    ]
  },
